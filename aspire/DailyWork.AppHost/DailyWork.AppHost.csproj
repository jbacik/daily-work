<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.1" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>dailywork-apphost</UserSecretsId>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Aspire Dashboard SDK injects platform-specific packages (e.g. linux-x64) that
         the Windows-generated lock file doesn't know about. Disable locked-mode
         enforcement here while keeping the lock file for caching on the same platform. -->
    <RestoreLockedMode>false</RestoreLockedMode>
    <!-- Aspire 13.5+ can source the dashboard and orchestrator from the Aspire CLI bundle
         instead of the platform-specific NuGet packages. Staying on the NuGet packages keeps
         the AppHost buildable without a matching CLI on the machine (and in CI). ASPIRE010 is
         the SDK nagging about that choice, so suppress it rather than build with a warning.
         Switching to the bundle would also retire the RID churn noted above — worth doing as
         its own change, not bundled into a version bump. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <!-- Direct reference to force patched version; resolves GHSA-hv8m-jj95-wg3x -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\api\src\DailyWork.Api.csproj" />
    <ProjectReference Include="..\DailyWork.ServiceDefaults\DailyWork.ServiceDefaults.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
